# ========================================
# सेवा आरोग्य (Seva Health) — Environment Variables Example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ========================================

# ── Authentication (required) ──────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── SMS Gateways ───────────────────────────────────────────
# 1. TextBee (Recommended - 100% Free, No DLT, sends via Android phone): https://textbee.dev
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# 2. Fast2SMS (Indian Gateway): https://www.fast2sms.com
FAST2SMS_API_KEY=

# Twilio (optional alternative)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Development flags ──────────────────────────────────────
# Set ALLOW_DEV_TEST_OTP=1 to have devOtp returned in OTP responses (non-production only).
# Also set ALLOW_DEV_TEST_OTP_VALUE to a fixed OTP for automated CI tests.
# These are IGNORED when NODE_ENV=production.
# ALLOW_DEV_TEST_OTP=1
# ALLOW_DEV_TEST_OTP_VALUE=123456
